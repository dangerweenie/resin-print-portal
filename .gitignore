# Runtime data and secrets — these live only on deployed devices, never in
# the repo. Local dev/tests generate their own throwaway copies.
settings.json
settings.json.bak-*
uploads.db
uploads.db.bak-*
.secret_key
.api_key
.initial_admin_password
files/

# Python (legacy Flask app — being retired)
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Go
/bin/
*.test
coverage.out

# Fleet provisioning secrets (portal URL + enrollment token)
provisioning/fleet.env

# Helm: the Bitnami postgresql subchart is fetched with `helm dependency build`
# from Chart.lock, not committed.
deploy/helm/*/charts/
deploy/helm/*/*.tgz

# Large real member print files used for hands-on testing — not fixture data
# worth committing (large binaries, some carry real members' names).
sliced_scenes/
