# Copy to provisioning/fleet.env (gitignored) and fill in. provision-sd.sh
# sources this so you set the portal details ONCE, not per SD card.

# REQUIRED. Base URL of the central portal (no trailing slash). Same on every Pi.
CENTRAL_URL=https://portal.tinkermill.org

# OPTIONAL. Leave blank for open enrollment — a fresh Pi registers itself and an
# admin approves it once; that approval is the security gate. Set a long random
# string (matching the portal's app.enrollToken / ENROLL_TOKEN) only if the
# portal is reachable from the public internet and you want to stop strangers
# from creating pending-printer rows.
ENROLL_TOKEN=

# Every Pi is fob-only — an MFRC522 wired to SPI0.0 / GPIO25, members tap to
# identify. That is not configurable and there is no name-entry fallback.
