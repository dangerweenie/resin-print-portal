# Copy to /etc/resin-pi-agent.env and fill in. Read by resin-pi-agent.service.
#
# The one required fleet constant is CENTRAL_BASE_URL — the same on every Pi.
# Set it once (in provisioning/fleet.env, or here) and the Pi self-registers
# with the portal on first boot. No per-Pi slug or API key.

# Base URL of the central portal (no trailing slash).
CENTRAL_BASE_URL=https://portal.tinkermill.org

# Optional. Only needed if the portal is configured to require an enrollment
# token (ENROLL_TOKEN on the server side). Leave blank for open enrollment,
# where an admin approving the Pi is the only gate.
ENROLL_TOKEN=

# --- everything below has sane defaults; leave as-is unless you know better ---

# USB gadget image the printer reads from.
GADGET_IMAGE=/piusb.bin

# Address the upload page listens on (port 80 = plain http on the LAN).
LISTEN_ADDR=:80

# Path to usb-refresh.sh (installed by install.sh).
USB_REFRESH_SCRIPT=/usr/local/bin/usb-refresh.sh

# Where the agent stores the slug + API key it gets from enrollment.
CREDS_PATH=/var/lib/resin-pi-agent/creds.env

LOG_LEVEL=info

# Manual override (dev / a hand-made printer): set these two and enrollment is
# skipped entirely.
# PRINTER_SLUG=resin
# PRINTER_API_KEY=...
