[Unit]
Description=Resin print portal — on-Pi upload agent
After=network-online.target
Wants=network-online.target
# The USB gadget must be loadable; usb-refresh.sh (re)loads g_mass_storage.
After=piusb-gadget.service
# Keep restarting long enough for agent-guard.sh (rolls back at 5 starts / 600s)
# to act on a bad self-update before systemd's own limiter (10 / 600s) parks the
# unit.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# Root is required: the agent shells out to usb-refresh.sh, which runs
# modprobe / losetup / mount.
User=root
EnvironmentFile=/etc/resin-pi-agent.env
# Creates /var/lib/resin-pi-agent (0700, root) for the persisted enrollment
# credentials, device id, and self-update bookkeeping.
StateDirectory=resin-pi-agent
# Crash-loop guard: if a bad self-update makes pi-agent restart repeatedly and a
# known-good pi-agent.prev exists, roll back to it before the next start.
ExecStartPre=-/usr/local/bin/agent-guard.sh
ExecStart=/usr/local/bin/pi-agent
# Restart=always (not on-failure): a self-update triggers a clean exit(0) and
# relies on systemd to bring the new binary back up.
Restart=always
RestartSec=3
# Light hardening — still needs broad access for the gadget plumbing.
NoNewPrivileges=false
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
